{
  "name": "edith-workspace",
  "version": "1.0.0",
  "description": "Unified orchestration for JARVIS (E.D.I.T.H.)",
  "private": true,
  "scripts": {
    "ui:install": "cd ui && npm install",
    "ui:dev": "cd ui && npm run dev",
    "api:dev": "set PYTHONUNBUFFERED=1 && venv\\Scripts\\python.exe api.py",
    "dev": "concurrently \"npm run api:dev\" \"npm run ui:dev\"",
    "desktop": "cd ui && npm run desktop",
    "desktop:dev": "cd ui && npm run desktop:dev",
    "build": "cd ui && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
